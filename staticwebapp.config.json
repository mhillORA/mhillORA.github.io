{
  "platform": {
    "apiRuntime": "node:20"
  },
  "routes": [
    {
      "route": "/api/health",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/entra-config",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/users/authenticate",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/users/authenticate-entra",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/access-requests",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/access-requests/*",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/econsent/*",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/sites",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/sites/*",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/*",
      "methods": ["GET", "POST", "PUT", "DELETE", "PATCH", "OPTIONS"]
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/api/*",
      "*.{css,js,png,jpg,gif,svg,ico,json,woff,woff2}"
    ]
  }
}
