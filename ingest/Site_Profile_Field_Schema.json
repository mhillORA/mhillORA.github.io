{
  "metadata": {
    "version": "1.0",
    "generated": "2026-08-25",
    "description": "Recommended field schema for the Site Profile Master in Cosmos DB. Three layers: profile (stable), indication (tagged by TA), study-specific (collected fresh)."
  },
  "profile_fields": {
    "description": "Stable data that carries across all studies. Pre-populated and confirmed on each new feasibility.",
    "sections": {
      "site_details": {
        "label": "Site Details",
        "fields": {
          "institution_name": {
            "type": "string",
            "required": true,
            "description": "Legal name of the institution"
          },
          "site_type": {
            "type": "enum",
            "options": [
              "Private Practice",
              "Dedicated Research Center",
              "Academic Medical Center",
              "Hospital-Based",
              "Community Health Center"
            ],
            "required": true
          },
          "address_street": {
            "type": "string",
            "required": true
          },
          "address_city": {
            "type": "string",
            "required": true
          },
          "address_state": {
            "type": "string",
            "required": true
          },
          "address_zip": {
            "type": "string",
            "required": true
          },
          "address_country": {
            "type": "string",
            "required": true,
            "default": "US"
          },
          "phone": {
            "type": "string",
            "required": true
          },
          "fax": {
            "type": "string",
            "required": false
          },
          "multi_site": {
            "type": "boolean",
            "description": "Does the site have satellite offices?"
          },
          "satellite_locations": {
            "type": "array",
            "items": "string",
            "description": "List of satellite addresses if multi-site"
          },
          "office_hours": {
            "type": "string",
            "description": "e.g., 8:00 AM \u2013 5:00 PM Mon-Fri"
          },
          "smo_affiliation": {
            "type": "string",
            "description": "SMO name if applicable"
          },
          "smo_staffing_model": {
            "type": "enum",
            "options": [
              "None",
              "Limited SMO",
              "Full SMO"
            ]
          }
        }
      },
      "principal_investigators": {
        "label": "Principal Investigators",
        "fields": {
          "investigators": {
            "type": "array",
            "items": {
              "name": {
                "type": "string",
                "required": true
              },
              "credentials": {
                "type": "string",
                "description": "e.g., MD, PhD"
              },
              "specialty": {
                "type": "string"
              },
              "email": {
                "type": "string"
              },
              "phone": {
                "type": "string"
              },
              "board_certified": {
                "type": "boolean"
              },
              "years_research_experience": {
                "type": "number"
              },
              "total_trials_conducted": {
                "type": "number"
              },
              "role": {
                "type": "enum",
                "options": [
                  "PI",
                  "Sub-I",
                  "Co-PI"
                ]
              },
              "is_primary": {
                "type": "boolean"
              }
            }
          }
        }
      },
      "contacts": {
        "label": "Key Contacts",
        "description": "Stored with timestamp. Most recent = primary.",
        "fields": {
          "contacts": {
            "type": "array",
            "items": {
              "role": {
                "type": "enum",
                "options": [
                  "Primary Contact",
                  "Study Coordinator",
                  "Contracts/Budget",
                  "Regulatory",
                  "IRB Coordinator",
                  "Data Entry"
                ],
                "required": true
              },
              "name": {
                "type": "string",
                "required": true
              },
              "title": {
                "type": "string"
              },
              "email": {
                "type": "string",
                "required": true
              },
              "phone": {
                "type": "string"
              },
              "last_confirmed": {
                "type": "date"
              },
              "source_study": {
                "type": "string",
                "description": "Study from which this contact was last confirmed"
              }
            }
          }
        }
      },
      "irb_regulatory": {
        "label": "IRB & Regulatory",
        "fields": {
          "irb_type": {
            "type": "enum",
            "options": [
              "Central",
              "Local",
              "Either"
            ],
            "required": true
          },
          "central_irb_name": {
            "type": "string",
            "description": "e.g., Advarra, WCG"
          },
          "irb_meeting_frequency": {
            "type": "string"
          },
          "irb_submission_lead_days": {
            "type": "number",
            "description": "Workdays in advance"
          },
          "avg_irb_approval_days": {
            "type": "number"
          },
          "additional_committees_required": {
            "type": "boolean"
          },
          "additional_committee_details": {
            "type": "string"
          },
          "contract_parallel_with_irb": {
            "type": "boolean"
          },
          "contract_required_before_irb": {
            "type": "boolean"
          },
          "gcp_compliant": {
            "type": "boolean",
            "required": true
          },
          "fda_audit_history": {
            "type": "boolean"
          },
          "fda_483_issued": {
            "type": "boolean"
          },
          "fda_audit_year": {
            "type": "number"
          },
          "ibc_registered": {
            "type": "boolean",
            "description": "Relevant for gene therapy"
          },
          "ibc_provider": {
            "type": "string",
            "description": "e.g., Advarra, Sabai"
          }
        }
      },
      "equipment": {
        "label": "Equipment & Capabilities",
        "fields": {
          "equipment_list": {
            "type": "array",
            "items": {
              "category": {
                "type": "enum",
                "options": [
                  "Imaging",
                  "Visual Acuity",
                  "Tonometry",
                  "Refraction",
                  "Slit Lamp",
                  "Photography",
                  "Lab/Specimen",
                  "Surgical",
                  "Monitoring",
                  "Other"
                ]
              },
              "name": {
                "type": "string",
                "required": true,
                "description": "e.g., SD-OCT, MAIA, Fundus Camera"
              },
              "make_model": {
                "type": "string",
                "description": "e.g., Heidelberg Spectralis HRA+OCT"
              },
              "software_version": {
                "type": "string"
              },
              "owned": {
                "type": "boolean"
              },
              "notes": {
                "type": "string"
              }
            }
          },
          "etdrs_certified_lanes": {
            "type": "number"
          },
          "etdrs_light_box": {
            "type": "boolean"
          },
          "etdrs_charts": {
            "type": "string",
            "description": "e.g., Charts 1, 2, R"
          },
          "certified_va_examiners": {
            "type": "number"
          },
          "certified_oct_photographers": {
            "type": "number"
          },
          "exam_rooms_available": {
            "type": "number"
          },
          "qcsf_capability": {
            "type": "boolean"
          },
          "cae_experience": {
            "type": "boolean",
            "description": "Controlled Adverse Environment capability"
          },
          "cae_space_available": {
            "type": "boolean"
          },
          "block_enrollment_capable": {
            "type": "boolean"
          }
        }
      },
      "reading_center_certifications": {
        "label": "Reading Center Certifications",
        "fields": {
          "certifications": {
            "type": "array",
            "items": {
              "reading_center": {
                "type": "string",
                "description": "e.g., OIRRC, Merit, Duke DIRC"
              },
              "certified": {
                "type": "boolean"
              },
              "certification_date": {
                "type": "date"
              },
              "expiration_date": {
                "type": "date"
              }
            }
          }
        }
      },
      "pharmacy_ip_storage": {
        "label": "Pharmacy & IP Storage",
        "fields": {
          "on_site_pharmacy": {
            "type": "boolean"
          },
          "aseptic_prep_area": {
            "type": "boolean"
          },
          "drug_refrigerator_2_8c": {
            "type": "boolean"
          },
          "freezer_minus_20c": {
            "type": "boolean"
          },
          "freezer_minus_80c": {
            "type": "boolean"
          },
          "room_temp_locked_storage": {
            "type": "boolean"
          },
          "temp_monitoring_24_7": {
            "type": "boolean"
          },
          "temp_monitoring_alarmed": {
            "type": "boolean"
          },
          "backup_generator": {
            "type": "boolean"
          },
          "clia_waiver": {
            "type": "boolean"
          },
          "clia_cert_number": {
            "type": "string"
          },
          "clia_expiration": {
            "type": "date"
          },
          "compounding_pharmacy_relationship": {
            "type": "string"
          },
          "dry_ice_access": {
            "type": "boolean"
          }
        }
      },
      "lab_specimen": {
        "label": "Lab & Specimen Handling",
        "fields": {
          "phlebotomist_on_staff": {
            "type": "boolean"
          },
          "centrifuge_available": {
            "type": "boolean"
          },
          "centrifuge_make_model": {
            "type": "string"
          },
          "refrigerated_centrifuge": {
            "type": "boolean"
          },
          "iata_certified_staff": {
            "type": "boolean"
          },
          "pk_sampling_experience": {
            "type": "boolean"
          },
          "specimen_processing_capability": {
            "type": "array",
            "items": "string",
            "description": "e.g., blood, tear samples, nasal swabs"
          }
        }
      },
      "staffing": {
        "label": "Staffing Resources",
        "fields": {
          "study_coordinators_count": {
            "type": "number"
          },
          "coordinators_full_time": {
            "type": "boolean"
          },
          "coordinator_experience_years": {
            "type": "number"
          },
          "imaging_techs_count": {
            "type": "number"
          },
          "dedicated_regulatory_staff": {
            "type": "boolean"
          },
          "dedicated_data_entry": {
            "type": "boolean"
          },
          "cpr_certified_staff": {
            "type": "boolean"
          },
          "vitreoretinal_surgeon_access": {
            "type": "boolean"
          }
        }
      },
      "contract_startup": {
        "label": "Contract & Startup",
        "fields": {
          "avg_contract_negotiation_weeks": {
            "type": "number"
          },
          "avg_budget_turnaround_weeks": {
            "type": "number"
          },
          "estimated_total_startup_weeks": {
            "type": "number"
          },
          "electronic_signatures_accepted": {
            "type": "boolean"
          },
          "icf_translation_languages": {
            "type": "array",
            "items": "string"
          },
          "separate_budget_office": {
            "type": "boolean"
          }
        }
      },
      "medical_records": {
        "label": "Medical Records & Systems",
        "fields": {
          "source_records_type": {
            "type": "enum",
            "options": [
              "Paper",
              "Electronic",
              "Hybrid"
            ]
          },
          "emr_system": {
            "type": "string"
          },
          "edc_systems_used": {
            "type": "array",
            "items": "string",
            "description": "e.g., Medidata, iMedNet, Veeva"
          },
          "remote_monitoring_capable": {
            "type": "boolean"
          },
          "guest_wifi_for_monitors": {
            "type": "boolean"
          }
        }
      },
      "research_experience": {
        "label": "Research Experience",
        "fields": {
          "years_of_research": {
            "type": "number"
          },
          "total_trials_conducted": {
            "type": "number"
          },
          "phase_experience": {
            "type": "array",
            "items": "string",
            "description": "e.g., Phase 1, 2, 3, 4"
          },
          "gene_therapy_experience": {
            "type": "boolean"
          },
          "gene_therapy_trial_count": {
            "type": "number"
          }
        }
      }
    }
  },
  "indication_fields": {
    "description": "Tagged by therapeutic area. Stored in profile but filtered by indication relevance. Confirmed when a new study matches the indication.",
    "fields": {
      "indication_profiles": {
        "type": "array",
        "items": {
          "indication": {
            "type": "string",
            "required": true,
            "description": "e.g., Dry AMD, GA, Wet AMD, Dry Eye, DME, Glaucoma"
          },
          "patient_database_size": {
            "type": "number",
            "description": "Total patients with this condition in site database"
          },
          "trials_completed_in_indication": {
            "type": "number"
          },
          "trials_currently_enrolling": {
            "type": "number"
          },
          "estimated_monthly_patient_volume": {
            "type": "number"
          },
          "patient_travel_radius_miles": {
            "type": "number"
          },
          "last_confirmed": {
            "type": "date"
          },
          "source_study": {
            "type": "string"
          }
        }
      }
    }
  },
  "study_specific_fields": {
    "description": "Always collected fresh for each new study. Never pre-populated.",
    "fields": {
      "study_interest": {
        "type": "boolean",
        "description": "Is the site interested in this specific study?"
      },
      "enrollment_estimate": {
        "type": "number",
        "description": "Estimated patients this site can enroll for this protocol"
      },
      "screen_failure_estimate_pct": {
        "type": "number",
        "description": "Anticipated screen fail rate"
      },
      "competing_studies": {
        "type": "array",
        "items": "string",
        "description": "List of active competing studies"
      },
      "competing_study_impact": {
        "type": "string",
        "description": "How competing studies affect enrollment capacity"
      },
      "current_staffing_capacity": {
        "type": "enum",
        "options": [
          "Can absorb",
          "Needs additional coordinator",
          "Cannot take on"
        ]
      },
      "protocol_concerns": {
        "type": "string",
        "description": "Any concerns about study design, I/E criteria, visit schedule"
      },
      "visit_schedule_feasible": {
        "type": "boolean"
      },
      "equipment_gaps": {
        "type": "string",
        "description": "Any equipment gaps vs. protocol requirements"
      },
      "recruitment_strategy": {
        "type": "string",
        "description": "How site plans to recruit \u2014 database, referral, advertising"
      },
      "advertising_needed": {
        "type": "boolean"
      }
    }
  }
}